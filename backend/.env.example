# Secrets are generated per server process when these values are empty.
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///visionvault.db
DATASET_PATH=../data/GHIM-10K
UPLOAD_FOLDER=../data/uploads
THUMBNAIL_FOLDER=../data/thumbnails
INDEX_FOLDER=../data/index
# Explicitly opt in to a local admin account before starting the server.
DEMO_EMAIL=
DEMO_PASSWORD=
ENABLE_REGISTRATION=false
MAX_CONTENT_LENGTH=16777216
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
